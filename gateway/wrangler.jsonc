{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chatext-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "APPLE_APP_ID": "6814798032",
    "APPLE_BUNDLE_ID": "kuramot6f.chatext",
    "CLOUDFLARE_AI_GATEWAY_ID": "chatext"
  },
  "ai": { "binding": "AI" },
  "triggers": { "crons": ["0 * * * *"] },
  "ratelimits": [
    { "name": "UPLOAD_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      // Wrangler binds the existing database by name.
      "database_name": "chatext-gateway"
    }
  ]
}
