{
  "name": "chatext-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "wrangler types && tsc --noEmit",
    "db:init": "wrangler d1 execute chatext-gateway --remote --file schema.sql",
    "db:init:local": "wrangler d1 execute chatext-gateway --local --file schema.sql",
    "db:migrate:tokens": "node scripts/migrate-token-hashes.mjs --remote",
    "db:migrate:tokens:local": "node scripts/migrate-token-hashes.mjs --local"
  },
  "dependencies": {
    "@apple/app-store-server-library": "3.1.0",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@types/node": "25.4.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.135.0"
  }
}
