    "If you haven’t turned on chatext yet, go to Settings > Apps > Safari > Extensions." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falls du chatext noch nicht aktiviert hast, öffne Einstellungen > Apps > Safari > Erweiterungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si aún no has activado chatext, ve a Ajustes > Apps > Safari > Extensiones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous n’avez pas encore activé chatext, accédez à Réglages > Apps > Safari > Extensions."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "chatextをまだオンにしていない場合は、設定 > アプリ > Safari > 機能拡張 を開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 chatext를 켜지 않았다면 설정 > 앱 > Safari > 확장 프로그램으로 이동하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você ainda não ativou o chatext, acesse Ajustes > Apps > Safari > Extensões."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果尚未开启 chatext，请前往“设置”>“App”>“Safari 浏览器”>“扩展”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若尚未開啟 chatext，請前往「設定」>「App」>「Safari」>「延伸功能」。"
          }
        }
      }
    },
