    "Check that the Plus and Pro subscriptions are available in App Store Connect for this app." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe, ob die Abos Plus und Pro in App Store Connect für diese App verfügbar sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba que las suscripciones Plus y Pro estén disponibles en App Store Connect para esta app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez que les abonnements Plus et Pro sont disponibles dans App Store Connect pour cette app."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pastikan langganan Plus dan Pro tersedia di App Store Connect untuk app ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica che gli abbonamenti Plus e Pro siano disponibili in App Store Connect per questa app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store ConnectでこのアプリのPlusとProのサブスクリプションが利用可能か確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect에서 이 앱의 Plus 및 Pro 구독을 사용할 수 있는지 확인하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique se as assinaturas Plus e Pro estão disponíveis no App Store Connect para este app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверьте, что подписки Plus и Pro доступны для этого приложения в App Store Connect."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus ve Pro aboneliklerinin bu uygulama için App Store Connect’te kullanılabilir olduğunu kontrol edin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy kiểm tra xem gói đăng ký Plus và Pro đã khả dụng trong App Store Connect cho ứng dụng này chưa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请确认此 App 的 Plus 和 Pro 订阅已在 App Store Connect 中可用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請確認此 App 的 Plus 和 Pro 訂閱已在 App Store Connect 中可用。"
          }
        }
      }
    },
